EnergyManagementSystem:Program,
  central_ac_and_furnace_supply_fan_disaggregate_program, !- Name
  Set central_ac_and_furnace_supply_fan_clg = 0, !- Program Line 1
  If central_ac_and_furnace_clg_coil_s > 0, !- Program Line 2
  Set central_ac_and_furnace_supply_fan_clg = central_ac_and_furnace_supply_fan_s, !- Program Line 3
  EndIf;                                  !- Program Line 4

EnergyManagementSystem:Program,
  central_ac_and_furnace_supply_fan_disaggregate_program_1, !- Name
  Set central_ac_and_furnace_supply_fan_primary_htg = 0, !- Program Line 1
  If central_ac_and_furnace_htg_coil_s > 0, !- Program Line 2
  Set central_ac_and_furnace_supply_fan_primary_htg = central_ac_and_furnace_supply_fan_s_1, !- Program Line 3
  EndIf;                                  !- Program Line 4

EnergyManagementSystem:Program,
  infil_program,                          !- Name
  Set p_m = 0.14,                         !- Program Line 1
  Set p_s = 0.22,                         !- Program Line 2
  Set s_m = 270,                          !- Program Line 3
  Set s_s = 370,                          !- Program Line 4
  Set z_m = 9.99744,                      !- Program Line 5
  Set z_s = 2.9718,                       !- Program Line 6
  Set f_t = (((s_m/z_m)^p_m)*((z_s/s_s)^p_s)), !- Program Line 7
  Set Tdiff = tin_s-tout_s,               !- Program Line 8
  Set dT = @Abs Tdiff,                    !- Program Line 9
  Set c = 0.166,                          !- Program Line 10
  Set Cs = 0.0649,                        !- Program Line 11
  Set Cw = 0.1637,                        !- Program Line 12
  Set n = 0.65,                           !- Program Line 13
  Set sft = (f_t*0.5),                    !- Program Line 14
  Set temp1 = ((c*Cw)*((sft*site_vw_s)^(2*n)))^2, !- Program Line 15
  Set Qinf = (((c*Cs*(dT^n))^2)+temp1)^0.5, !- Program Line 16
  Set Qinf = (@Max Qinf 0),               !- Program Line 17
  Set mech_vent_house_fan_sensible_load_equip_act = 0.0, !- Program Line 18
  Set mech_vent_house_fan_latent_load_equip_act = 0.0, !- Program Line 19
  Set OASupInPb = out_pb_s,               !- Program Line 20
  Set OASupInTemp = tout_s,               !- Program Line 21
  Set OASupInW = out_wt_s,                !- Program Line 22
  Set OASupRho = (@RhoAirFnPbTdbW OASupInPb OASupInTemp OASupInW), !- Program Line 23
  Set OASupCp = (@CpAirFnW OASupInW),     !- Program Line 24
  Set OASupInEnth = (@HFnTdbW OASupInTemp OASupInW), !- Program Line 25
  Set ZoneTemp = tin_s,                   !- Program Line 26
  Set ZoneW = win_s,                      !- Program Line 27
  Set ZoneCp = (@CpAirFnW ZoneW),         !- Program Line 28
  Set ZoneAirEnth = (@HFnTdbW ZoneTemp ZoneW), !- Program Line 29
  Set mech_vent_house_fan_cfis_act = 0.0, !- Program Line 30
  Set QWHV_cfis_sup = 0.0,                !- Program Line 31
  Set QWHV_cfis_suppl_sup = 0.0,          !- Program Line 32
  Set QWHV_cfis_suppl_exh = 0.0,          !- Program Line 33
  Set Qrange = 0,                         !- Program Line 34
  Set Qrange = Qrange + 0.04719 * mech_vent_range_fan_0_sch_s, !- Program Line 35
  Set Qbath = 0,                          !- Program Line 36
  Set Qbath = Qbath + 0.04719 * mech_vent_bath_fan_0_sch_s, !- Program Line 37
  Set Qdryer = 0,                         !- Program Line 38
  Set Qdryer = Qdryer + 0.03334 * clothes_dryer_exhaust_0_sch_s, !- Program Line 39
  Set QWHV_sup = 0.0,                     !- Program Line 40
  Set QWHV_exh = 0.0,                     !- Program Line 41
  Set Qexhaust = Qrange + Qbath + Qdryer + QWHV_exh + QWHV_cfis_suppl_exh, !- Program Line 42
  Set Qsupply = QWHV_sup + QWHV_cfis_sup + QWHV_cfis_suppl_sup, !- Program Line 43
  Set Qfan = (@Max Qexhaust Qsupply),     !- Program Line 44
  If Qfan > 0,                            !- Program Line 45
  Set Qavg = ((Qexhaust + Qsupply) / 2.0), !- Program Line 46
  If ((@Abs (Qexhaust - Qavg)) / Qavg) <= 0.1, !- Program Line 47
  Set phi = 1,                            !- Program Line 48
  Else,                                   !- Program Line 49
  Set phi = (Qinf / (Qinf + Qfan)),       !- Program Line 50
  EndIf,                                  !- Program Line 51
  Set Qinf_adj = phi * Qinf,              !- Program Line 52
  Else,                                   !- Program Line 53
  Set Qinf_adj = Qinf,                    !- Program Line 54
  EndIf,                                  !- Program Line 55
  Set infil_flow_act = Qinf_adj,          !- Program Line 56
  Set Qload = Qfan,                       !- Program Line 57
  Set Effectiveness_Sens = 0.0,           !- Program Line 58
  Set Effectiveness_Lat = 0.0,            !- Program Line 59
  Set Fan_MFR = Qload * OASupRho,         !- Program Line 60
  Set ZoneInEnth = OASupInEnth,           !- Program Line 61
  Set ZoneInTemp = OASupInTemp,           !- Program Line 62
  Set FanTotalToCond = Fan_MFR * (ZoneInEnth - ZoneAirEnth), !- Program Line 63
  Set FanSensToCond = Fan_MFR * ZoneCp * (ZoneInTemp - ZoneTemp), !- Program Line 64
  Set FanLatToCond = FanTotalToCond - FanSensToCond, !- Program Line 65
  Set mech_vent_house_fan_sensible_load_equip_act = mech_vent_house_fan_sensible_load_equip_act + FanSensToCond, !- Program Line 66
  Set mech_vent_house_fan_latent_load_equip_act = mech_vent_house_fan_latent_load_equip_act + FanLatToCond; !- Program Line 67

EnergyManagementSystem:Program,
  natural_vent_program,                   !- Name
  Set Tin = tin_s,                        !- Program Line 1
  Set Tout = tout_s,                      !- Program Line 2
  Set Wout = out_wt_s,                    !- Program Line 3
  Set Pbar = out_pb_s,                    !- Program Line 4
  Set Phiout = (@RhFnTdbWPb Tout Wout Pbar), !- Program Line 5
  Set MaxHR = 0.0115,                     !- Program Line 6
  Set MaxRH = 0.7,                        !- Program Line 7
  Set Tnvsp = (htg_sp_s + clg_sp_s) / 2,  !- Program Line 8
  Set NVavail = natural_vent_s,           !- Program Line 9
  Set ClgSsnAvail = cool_season,          !- Program Line 10
  Set natural_vent_flow_act = 0,          !- Program Line 11
  Set whole_house_fan_flow_act = 0,       !- Program Line 12
  Set whole_house_fan_mix_act = 0,        !- Program Line 13
  Set whole_house_fan_act = 0,            !- Program Line 14
  If ((Wout < MaxHR) && (Phiout < MaxRH) && (Tin > Tout) && (Tin > Tnvsp) && (ClgSsnAvail > 0)), !- Program Line 15
  Set WHF_Flow = 0,                       !- Program Line 16
  Set Adj = (Tin-Tnvsp)/(Tin-Tout),       !- Program Line 17
  Set Adj = (@Min Adj 1),                 !- Program Line 18
  Set Adj = (@Max Adj 0),                 !- Program Line 19
  If (WHF_Flow > 0),                      !- Program Line 20
  Set whole_house_fan_flow_act = WHF_Flow*Adj, !- Program Line 21
  Set whole_house_fan_mix_act = WHF_Flow*Adj, !- Program Line 22
  Set WHF_W = 0,                          !- Program Line 23
  Set whole_house_fan_act = WHF_W*Adj,    !- Program Line 24
  ElseIf (NVavail > 0),                   !- Program Line 25
  Set NVArea = 4817.76584832,             !- Program Line 26
  Set Cs = 0.00010930442197923115,        !- Program Line 27
  Set Cw = 6.798490431308354e-05,         !- Program Line 28
  Set Tdiff = Tin-Tout,                   !- Program Line 29
  Set dT = (@Abs Tdiff),                  !- Program Line 30
  Set Vwind = site_vw_s,                  !- Program Line 31
  Set SGNV = NVArea*Adj*((((Cs*dT)+(Cw*(Vwind^2)))^0.5)/1000), !- Program Line 32
  Set MaxNV = 2.1369780228096005,         !- Program Line 33
  Set natural_vent_flow_act = (@Min SGNV MaxNV), !- Program Line 34
  EndIf,                                  !- Program Line 35
  EndIf;                                  !- Program Line 36

EnergyManagementSystem:Program,
  total_loads_program,                    !- Name
  Set loads_htg_tot = 0,                  !- Program Line 1
  Set loads_clg_tot = 0,                  !- Program Line 2
  If htg_load_cond > 0,                   !- Program Line 3
  Set loads_htg_tot = loads_htg_tot + (htg_load_cond - clg_load_cond) * 1.0, !- Program Line 4
  EndIf,                                  !- Program Line 5
  If clg_load_cond > 0,                   !- Program Line 6
  Set loads_clg_tot = loads_clg_tot + (clg_load_cond - htg_load_cond) * 1.0, !- Program Line 7
  EndIf;                                  !- Program Line 8

EnergyManagementSystem:Program,
  unmet_hours_program,                    !- Name
  Set htg_unmet_hours = 0,                !- Program Line 1
  Set clg_unmet_hours = 0,                !- Program Line 2
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 3
  If zone_htg_unmet_s > htg_unmet_hours,  !- Program Line 4
  Set htg_unmet_hours = zone_htg_unmet_s, !- Program Line 5
  EndIf,                                  !- Program Line 6
  EndIf,                                  !- Program Line 7
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 8
  If zone_clg_unmet_s > clg_unmet_hours,  !- Program Line 9
  Set clg_unmet_hours = zone_clg_unmet_s, !- Program Line 10
  EndIf,                                  !- Program Line 11
  EndIf;                                  !- Program Line 12

EnergyManagementSystem:Program,
  water_heater_EC_adj,                    !- Name
  Set dhw_e_cons = water_heater_energy + water_heater_on_cycle_parasitic + water_heater_off_cycle_parasitic, !- Program Line 1
  Set water_heater_ec_adj_act = 0.0 * dhw_e_cons / 1; !- Program Line 2

