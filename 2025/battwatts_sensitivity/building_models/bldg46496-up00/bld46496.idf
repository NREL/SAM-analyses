  EndIf;                                  !- Program Line 4

EnergyManagementSystem:Program,
  infil_program,                          !- Name
  Set p_m = 0.14,                         !- Program Line 1
  Set p_s = 0.22,                         !- Program Line 2
  Set s_m = 270,                          !- Program Line 3
  Set s_s = 370,                          !- Program Line 4
  Set z_m = 9.99744,                      !- Program Line 5
  Set z_s = 2.4384,                       !- Program Line 6
  Set f_t = (((s_m/z_m)^p_m)*((z_s/s_s)^p_s)), !- Program Line 7
  Set Tdiff = tin_s-tout_s,               !- Program Line 8
  Set dT = @Abs Tdiff,                    !- Program Line 9
  Set c = 0.2172,                         !- Program Line 10
  Set Cs = 0.0642,                        !- Program Line 11
  Set Cw = 0.1461,                        !- Program Line 12
  Set n = 0.65,                           !- Program Line 13
  Set sft = (f_t*0.7000000000000001),     !- Program Line 14
  Set temp1 = ((c*Cw)*((sft*site_vw_s)^(2*n)))^2, !- Program Line 15
  Set Qinf = (((c*Cs*(dT^n))^2)+temp1)^0.5, !- Program Line 16
  Set Qinf = (@Max Qinf 0),               !- Program Line 17
  Set mech_vent_house_fan_sensible_load_equip_act = 0.0, !- Program Line 18
  Set mech_vent_house_fan_latent_load_equip_act = 0.0, !- Program Line 19
  Set OASupInPb = out_pb_s,               !- Program Line 20
  Set OASupInTemp = tout_s,               !- Program Line 21
  Set OASupInW = out_wt_s,                !- Program Line 22
  Set OASupRho = (@RhoAirFnPbTdbW OASupInPb OASupInTemp OASupInW), !- Program Line 23
  Set OASupCp = (@CpAirFnW OASupInW),     !- Program Line 24
  Set OASupInEnth = (@HFnTdbW OASupInTemp OASupInW), !- Program Line 25
  Set ZoneTemp = tin_s,                   !- Program Line 26
  Set ZoneW = win_s,                      !- Program Line 27
  Set ZoneCp = (@CpAirFnW ZoneW),         !- Program Line 28
  Set ZoneAirEnth = (@HFnTdbW ZoneTemp ZoneW), !- Program Line 29
  Set mech_vent_house_fan_cfis_act = 0.0, !- Program Line 30
  Set QWHV_cfis_sup = 0.0,                !- Program Line 31
  Set QWHV_cfis_suppl_sup = 0.0,          !- Program Line 32
  Set QWHV_cfis_suppl_exh = 0.0,          !- Program Line 33
  Set Qrange = 0,                         !- Program Line 34
  Set Qrange = Qrange + 0.04719 * mech_vent_range_fan_0_sch_s, !- Program Line 35
  Set Qbath = 0,                          !- Program Line 36
  Set Qbath = Qbath + 0.04719 * mech_vent_bath_fan_0_sch_s, !- Program Line 37
  Set Qdryer = 0,                         !- Program Line 38
  Set QWHV_sup = 0.0,                     !- Program Line 39
  Set QWHV_exh = 0.0,                     !- Program Line 40
  Set Qexhaust = Qrange + Qbath + Qdryer + QWHV_exh + QWHV_cfis_suppl_exh, !- Program Line 41
  Set Qsupply = QWHV_sup + QWHV_cfis_sup + QWHV_cfis_suppl_sup, !- Program Line 42
  Set Qfan = (@Max Qexhaust Qsupply),     !- Program Line 43
  If Qfan > 0,                            !- Program Line 44
  Set Qavg = ((Qexhaust + Qsupply) / 2.0), !- Program Line 45
  If ((@Abs (Qexhaust - Qavg)) / Qavg) <= 0.1, !- Program Line 46
  Set phi = 1,                            !- Program Line 47
  Else,                                   !- Program Line 48
  Set phi = (Qinf / (Qinf + Qfan)),       !- Program Line 49
  EndIf,                                  !- Program Line 50
  Set Qinf_adj = phi * Qinf,              !- Program Line 51
  Else,                                   !- Program Line 52
  Set Qinf_adj = Qinf,                    !- Program Line 53
  EndIf,                                  !- Program Line 54
  Set infil_flow_act = Qinf_adj,          !- Program Line 55
  Set Qload = Qfan,                       !- Program Line 56
  Set Effectiveness_Sens = 0.0,           !- Program Line 57
  Set Effectiveness_Lat = 0.0,            !- Program Line 58
  Set Fan_MFR = Qload * OASupRho,         !- Program Line 59
  Set ZoneInEnth = OASupInEnth,           !- Program Line 60
  Set ZoneInTemp = OASupInTemp,           !- Program Line 61
  Set FanTotalToCond = Fan_MFR * (ZoneInEnth - ZoneAirEnth), !- Program Line 62
  Set FanSensToCond = Fan_MFR * ZoneCp * (ZoneInTemp - ZoneTemp), !- Program Line 63
  Set FanLatToCond = FanTotalToCond - FanSensToCond, !- Program Line 64
  Set mech_vent_house_fan_sensible_load_equip_act = mech_vent_house_fan_sensible_load_equip_act + FanSensToCond, !- Program Line 65
  Set mech_vent_house_fan_latent_load_equip_act = mech_vent_house_fan_latent_load_equip_act + FanLatToCond; !- Program Line 66

EnergyManagementSystem:Program,
  natural_vent_program,                   !- Name
  Set Tin = tin_s,                        !- Program Line 1
  Set Tout = tout_s,                      !- Program Line 2
  Set Wout = out_wt_s,                    !- Program Line 3
  Set Pbar = out_pb_s,                    !- Program Line 4
  Set Phiout = (@RhFnTdbWPb Tout Wout Pbar), !- Program Line 5
  Set MaxHR = 0.0115,                     !- Program Line 6
  Set MaxRH = 0.7,                        !- Program Line 7
  Set Tnvsp = (htg_sp_s + clg_sp_s) / 2,  !- Program Line 8
  Set NVavail = natural_vent_s,           !- Program Line 9
  Set ClgSsnAvail = cool_season,          !- Program Line 10
  Set natural_vent_flow_act = 0,          !- Program Line 11
  Set whole_house_fan_flow_act = 0,       !- Program Line 12
  Set whole_house_fan_mix_act = 0,        !- Program Line 13
  Set whole_house_fan_act = 0,            !- Program Line 14
  If ((Wout < MaxHR) && (Phiout < MaxRH) && (Tin > Tout) && (Tin > Tnvsp) && (ClgSsnAvail > 0)), !- Program Line 15
  Set WHF_Flow = 0,                       !- Program Line 16
  Set Adj = (Tin-Tnvsp)/(Tin-Tout),       !- Program Line 17
  Set Adj = (@Min Adj 1),                 !- Program Line 18
  Set Adj = (@Max Adj 0),                 !- Program Line 19
  If (WHF_Flow > 0),                      !- Program Line 20
  Set whole_house_fan_flow_act = WHF_Flow*Adj, !- Program Line 21
  Set whole_house_fan_mix_act = WHF_Flow*Adj, !- Program Line 22
  Set WHF_W = 0,                          !- Program Line 23
  Set whole_house_fan_act = WHF_W*Adj,    !- Program Line 24
  ElseIf (NVavail > 0),                   !- Program Line 25
  Set NVArea = 10479.574395648,           !- Program Line 26
  Set Cs = 8.968567957270247e-05,         !- Program Line 27
  Set Cw = 6.158219665777789e-05,         !- Program Line 28
  Set Tdiff = Tin-Tout,                   !- Program Line 29
  Set dT = (@Abs Tdiff),                  !- Program Line 30
  Set Vwind = site_vw_s,                  !- Program Line 31
  Set SGNV = NVArea*Adj*((((Cs*dT)+(Cw*(Vwind^2)))^0.5)/1000), !- Program Line 32
  Set MaxNV = 2.7423292766208007,         !- Program Line 33
  Set natural_vent_flow_act = (@Min SGNV MaxNV), !- Program Line 34
  EndIf,                                  !- Program Line 35
  EndIf;                                  !- Program Line 36

EnergyManagementSystem:Program,
  total_loads_program,                    !- Name
  Set loads_htg_tot = 0,                  !- Program Line 1
  Set loads_clg_tot = 0,                  !- Program Line 2
  If htg_load_cond > 0,                   !- Program Line 3
  Set loads_htg_tot = loads_htg_tot + (htg_load_cond - clg_load_cond) * 1.0, !- Program Line 4
  Set loads_htg_tot = loads_htg_tot + (htg_load_duct - clg_load_duct) * 1.0, !- Program Line 5
  EndIf,                                  !- Program Line 6
  If clg_load_cond > 0,                   !- Program Line 7
  Set loads_clg_tot = loads_clg_tot + (clg_load_cond - htg_load_cond) * 1.0, !- Program Line 8
  Set loads_clg_tot = loads_clg_tot + (clg_load_duct - htg_load_duct) * 1.0, !- Program Line 9
  EndIf;                                  !- Program Line 10

EnergyManagementSystem:Program,
  unmet_hours_program,                    !- Name
  Set htg_unmet_hours = 0,                !- Program Line 1
  Set clg_unmet_hours = 0,                !- Program Line 2
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 3
  If zone_htg_unmet_s > htg_unmet_hours,  !- Program Line 4
  Set htg_unmet_hours = zone_htg_unmet_s, !- Program Line 5
  EndIf,                                  !- Program Line 6
  EndIf,                                  !- Program Line 7
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 8
  If zone_clg_unmet_s > clg_unmet_hours,  !- Program Line 9
  Set clg_unmet_hours = zone_clg_unmet_s, !- Program Line 10
  EndIf,                                  !- Program Line 11
  EndIf;                                  !- Program Line 12

EnergyManagementSystem:Program,
  water_heater_EC_adj,                    !- Name
  Set dhw_e_cons = water_heater_energy + water_heater_on_cycle_parasitic + water_heater_off_cycle_parasitic, !- Program Line 1
  Set water_heater_ec_adj_act = 0.0 * dhw_e_cons / 1; !- Program Line 2

EnergyManagementSystem:Subroutine,
  central_ac_and_furnace_airloop_0_duct_subroutine, !- Name
  Set AH_MFR = central_ac_and_furnace_airloop_AH_MFR / 1, !- Program Line 1
  If AH_MFR>0,                            !- Program Line 2
  Set AH_Tout = central_ac_and_furnace_airloop_AH_Tout, !- Program Line 3
  Set AH_Wout = central_ac_and_furnace_airloop_AH_Wout, !- Program Line 4
  Set RA_T = central_ac_and_furnace_airloop_RA_T, !- Program Line 5
  Set RA_W = central_ac_and_furnace_airloop_Ra_W, !- Program Line 6
  Set Fan_RTF = central_ac_and_furnace_airloop_Fan_RTF, !- Program Line 7
  Set DZ_T = central_ac_and_furnace_airloop_0_DZ_T, !- Program Line 8
  Set DZ_W = central_ac_and_furnace_airloop_0_DZ_W, !- Program Line 9
  Set AH_VFR = central_ac_and_furnace_airloop_AH_VFR / 1, !- Program Line 10
  Set h_SA = (@HFnTdbW AH_Tout AH_Wout),  !- Program Line 11
  Set h_RA = (@HFnTdbW RA_T RA_W),        !- Program Line 12
  Set h_fg = (@HfgAirFnWTdb AH_Wout AH_Tout), !- Program Line 13
  Set h_DZ = (@HFnTdbW DZ_T DZ_W),        !- Program Line 14
  Set air_cp = 1006.0,                    !- Program Line 15
  Set f_sup = 0.2,                        !- Program Line 16
  Set f_ret = 0.1,                        !- Program Line 17
  Set sup_lk_mfr = f_sup * AH_MFR,        !- Program Line 18
  Set ret_lk_mfr = f_ret * AH_MFR,        !- Program Line 19
  Set SupTotLkToCond = sup_lk_mfr*(h_RA - h_SA), !- Program Line 20
  Set SupLatLkToCond = sup_lk_mfr*h_fg*(RA_W-AH_Wout), !- Program Line 21
  Set SupSensLkToCond = SupTotLkToCond-SupLatLkToCond, !- Program Line 22
  Set supply_ua = 69.097,                 !- Program Line 23
  Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*supply_ua), !- Program Line 24
  Set t_sup = DZ_T+((AH_Tout-DZ_T)*(@Exp eTm)), !- Program Line 25
  Set SupCondToCond = AH_MFR*air_cp*(t_sup-AH_Tout), !- Program Line 26
  Set SupCondToDZ = 0-SupCondToCond,      !- Program Line 27
  Set return_ua = 11.825,                 !- Program Line 28
  Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*return_ua), !- Program Line 29
  Set t_ret = DZ_T+((RA_T-DZ_T)*(@Exp eTm)), !- Program Line 30
  Set RetCondToRP = AH_MFR*air_cp*(t_ret-RA_T), !- Program Line 31
  Set RetCondToDZ = 0-RetCondToRP,        !- Program Line 32
  Set RetLatLkToRP = 0,                   !- Program Line 33
  Set RetSensLkToRP = ret_lk_mfr*air_cp*(DZ_T-RA_T), !- Program Line 34
  Set SupTotLkToDZ = sup_lk_mfr*(h_SA-h_DZ), !- Program Line 35
  Set SupLatLkToDZ = sup_lk_mfr*h_fg*(AH_Wout-DZ_W), !- Program Line 36
  Set SupSensLkToDZ = SupTotLkToDZ-SupLatLkToDZ, !- Program Line 37
  Set f_imbalance = f_sup-f_ret,          !- Program Line 38
  Set oa_vfr = 1.0 * f_imbalance * AH_VFR, !- Program Line 39
  Set sup_lk_vfr = f_sup * AH_VFR,        !- Program Line 40
  Set ret_lk_vfr = f_ret * AH_VFR,        !- Program Line 41
  If f_sup > f_ret,                       !- Program Line 42
  Set ZoneMixCondToDZ = 0,                !- Program Line 43
  Set ZoneMixDZToCond = (sup_lk_vfr-ret_lk_vfr)-oa_vfr, !- Program Line 44
  Else,                                   !- Program Line 45
  Set ZoneMixCondToDZ = (ret_lk_vfr-sup_lk_vfr)+oa_vfr, !- Program Line 46
  Set ZoneMixDZToCond = 0,                !- Program Line 47
  EndIf,                                  !- Program Line 48
  Else,                                   !- Program Line 49
  Set SupLatLkToCond = 0,                 !- Program Line 50
  Set SupSensLkToCond = 0,                !- Program Line 51
  Set SupCondToCond = 0,                  !- Program Line 52
  Set RetCondToRP = 0,                    !- Program Line 53
  Set RetLatLkToRP = 0,                   !- Program Line 54
  Set RetSensLkToRP = 0,                  !- Program Line 55
  Set RetCondToDZ = 0,                    !- Program Line 56
  Set SupCondToDZ = 0,                    !- Program Line 57
  Set SupLatLkToDZ = 0,                   !- Program Line 58
  Set SupSensLkToDZ = 0,                  !- Program Line 59
  Set ZoneMixCondToDZ = 0,                !- Program Line 60
  Set ZoneMixDZToCond = 0,                !- Program Line 61
  EndIf,                                  !- Program Line 62
  Set central_ac_and_furnace_airloop_0_SupLatLkToCond = SupLatLkToCond, !- Program Line 63
  Set central_ac_and_furnace_airloop_0_SupSensLkToCond = SupSensLkToCond, !- Program Line 64
  Set central_ac_and_furnace_airloop_0_SupCondToLv = SupCondToCond, !- Program Line 65
  Set central_ac_and_furnace_airloop_0_RetCondToRP = RetCondToRP, !- Program Line 66
  Set central_ac_and_furnace_airloop_0_RetLatLkToRP = RetLatLkToRP, !- Program Line 67
  Set central_ac_and_furnace_airloop_0_RetSensLkToRP = RetSensLkToRP, !- Program Line 68
  Set central_ac_and_furnace_airloop_0_RetCondToDZ = RetCondToDZ, !- Program Line 69
  Set central_ac_and_furnace_airloop_0_SupCondToDZ = SupCondToDZ, !- Program Line 70
  Set central_ac_and_furnace_airloop_0_SupLatLkToDZ = SupLatLkToDZ, !- Program Line 71
  Set central_ac_and_furnace_airloop_0_SupSensLkToDZ = SupSensLkToDZ, !- Program Line 72
  Set central_ac_and_furnace_airloop_0_ZoneMixCondToDZ = ZoneMixCondToDZ, !- Program Line 73
  Set central_ac_and_furnace_airloop_0_ZoneMixDZToCond = ZoneMixDZToCond; !- Program Line 74

