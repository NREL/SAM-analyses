  Set central_ac_and_furnace_airloop_Fan_RTF = central_ac_and_furnace_airloop_Fan_RTF + central_ac_and_furnace_airloop_Fan_RTF_s, !- Program Line 3
  Set central_ac_and_furnace_airloop_Fan_RTF = central_ac_and_furnace_airloop_Fan_RTF + central_ac_and_furnace_airloop_Fan_RTF_s_1, !- Program Line 4
  Set central_ac_and_furnace_airloop_AH_VFR = central_ac_and_furnace_airloop_AH_VFR_s, !- Program Line 5
  Set central_ac_and_furnace_airloop_AH_Tout = central_ac_and_furnace_airloop_AH_Tout_s, !- Program Line 6
  Set central_ac_and_furnace_airloop_AH_Wout = central_ac_and_furnace_airloop_AH_Wout_s, !- Program Line 7
  Set central_ac_and_furnace_airloop_RA_T = central_ac_and_furnace_airloop_RA_T_s, !- Program Line 8
  Set central_ac_and_furnace_airloop_Ra_W = central_ac_and_furnace_airloop_Ra_W_s, !- Program Line 9
  Set central_ac_and_furnace_airloop_0_DZ_T = central_ac_and_furnace_airloop_0_DZ_T_s, !- Program Line 10
  Set central_ac_and_furnace_airloop_0_DZ_W = central_ac_and_furnace_airloop_0_DZ_W_s, !- Program Line 11
  Run central_ac_and_furnace_airloop_0_duct_subroutine, !- Program Line 12
  Set central_ac_and_furnace_airloop_0_SupSensLkToCond_equip_act = central_ac_and_furnace_airloop_0_SupSensLkToCond, !- Program Line 13
  Set central_ac_and_furnace_airloop_0_SupLatLkToCond_equip_act = central_ac_and_furnace_airloop_0_SupLatLkToCond, !- Program Line 14
  Set central_ac_and_furnace_airloop_0_SupCondToLv_equip_act = central_ac_and_furnace_airloop_0_SupCondToLv, !- Program Line 15
  Set central_ac_and_furnace_airloop_0_RetSensLkToRP_equip_act = central_ac_and_furnace_airloop_0_RetSensLkToRP, !- Program Line 16
  Set central_ac_and_furnace_airloop_0_RetLatLkToRP_equip_act = central_ac_and_furnace_airloop_0_RetLatLkToRP, !- Program Line 17
  Set central_ac_and_furnace_airloop_0_RetCondToRP_equip_act = central_ac_and_furnace_airloop_0_RetCondToRP, !- Program Line 18
  Set central_ac_and_furnace_airloop_0_RetCondToDZ_equip_act = central_ac_and_furnace_airloop_0_RetCondToDZ, !- Program Line 19
  Set central_ac_and_furnace_airloop_0_SupCondToDZ_equip_act = central_ac_and_furnace_airloop_0_SupCondToDZ, !- Program Line 20
  Set central_ac_and_furnace_airloop_0_SupSensLkToDZ_equip_act = central_ac_and_furnace_airloop_0_SupSensLkToDZ, !- Program Line 21
  Set central_ac_and_furnace_airloop_0_SupLatLkToDZ_equip_act = central_ac_and_furnace_airloop_0_SupLatLkToDZ, !- Program Line 22
  Set central_ac_and_furnace_airloop_0_ZoneMixDZToCond_mix_act = central_ac_and_furnace_airloop_0_ZoneMixDZToCond, !- Program Line 23
  Set central_ac_and_furnace_airloop_0_ZoneMixCondToDZ_mix_act = central_ac_and_furnace_airloop_0_ZoneMixCondToDZ; !- Program Line 24

