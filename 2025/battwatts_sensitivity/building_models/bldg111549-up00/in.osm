OS:EnergyManagementSystem:Program,
  {363f55d9-238d-4aa4-b6cb-d6cb7d0ecf76}, !- Handle
  natural_vent_program,                   !- Name
  Set Tin = tin_s,                        !- Program Line 1
  Set Tout = tout_s,                      !- Program Line 2
  Set Wout = out_wt_s,                    !- Program Line 3
  Set Pbar = out_pb_s,                    !- Program Line 4
  Set Phiout = (@RhFnTdbWPb Tout Wout Pbar), !- Program Line 5
  Set MaxHR = 0.0115,                     !- Program Line 6
  Set MaxRH = 0.7,                        !- Program Line 7
  Set Tnvsp = (htg_sp_s + clg_sp_s) / 2,  !- Program Line 8
  Set NVavail = natural_vent_s,           !- Program Line 9
  Set ClgSsnAvail = cool_season,          !- Program Line 10
  Set natural_vent_flow_act = 0,          !- Program Line 11
  Set whole_house_fan_flow_act = 0,       !- Program Line 12
  Set whole_house_fan_mix_act = 0,        !- Program Line 13
  Set whole_house_fan_act = 0,            !- Program Line 14
  If ((Wout < MaxHR) && (Phiout < MaxRH) && (Tin > Tout) && (Tin > Tnvsp) && (ClgSsnAvail > 0)), !- Program Line 15
  Set WHF_Flow = 0,                       !- Program Line 16
  Set Adj = (Tin-Tnvsp)/(Tin-Tout),       !- Program Line 17
  Set Adj = (@Min Adj 1),                 !- Program Line 18
  Set Adj = (@Max Adj 0),                 !- Program Line 19
  If (WHF_Flow > 0),                      !- Program Line 20
  Set whole_house_fan_flow_act = WHF_Flow*Adj, !- Program Line 21
  Set whole_house_fan_mix_act = WHF_Flow*Adj, !- Program Line 22
  Set WHF_W = 0,                          !- Program Line 23
  Set whole_house_fan_act = WHF_W*Adj,    !- Program Line 24
  ElseIf (NVavail > 0),                   !- Program Line 25
  Set NVArea = 5243.521900032001,         !- Program Line 26
  Set Cs = 8.968567957270247e-05,         !- Program Line 27
  Set Cw = 6.158219665777789e-05,         !- Program Line 28
  Set Tdiff = Tin-Tout,                   !- Program Line 29
  Set dT = (@Abs Tdiff),                  !- Program Line 30
  Set Vwind = site_vw_s,                  !- Program Line 31
  Set SGNV = NVArea*Adj*((((Cs*dT)+(Cw*(Vwind^2)))^0.5)/1000), !- Program Line 32
  Set MaxNV = 2.7423292766208007,         !- Program Line 33
  Set natural_vent_flow_act = (@Min SGNV MaxNV), !- Program Line 34
  EndIf,                                  !- Program Line 35
  EndIf;                                  !- Program Line 36

