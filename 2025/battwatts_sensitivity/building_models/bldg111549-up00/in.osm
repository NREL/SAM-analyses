OS:EnergyManagementSystem:Program,
  {c20e7725-0c50-41e9-aa6e-bb2a536116f4}, !- Handle
  infil_program,                          !- Name
  Set p_m = 0.14,                         !- Program Line 1
  Set p_s = 0.22,                         !- Program Line 2
  Set s_m = 270,                          !- Program Line 3
  Set s_s = 370,                          !- Program Line 4
  Set z_m = 9.99744,                      !- Program Line 5
  Set z_s = 2.4384,                       !- Program Line 6
  Set f_t = (((s_m/z_m)^p_m)*((z_s/s_s)^p_s)), !- Program Line 7
  Set Tdiff = tin_s-tout_s,               !- Program Line 8
  Set dT = @Abs Tdiff,                    !- Program Line 9
  Set c = 0.1085,                         !- Program Line 10
  Set Cs = 0.0557,                        !- Program Line 11
  Set Cw = 0.1598,                        !- Program Line 12
  Set n = 0.65,                           !- Program Line 13
  Set sft = (f_t*0.5),                    !- Program Line 14
  Set temp1 = ((c*Cw)*((sft*site_vw_s)^(2*n)))^2, !- Program Line 15
  Set Qinf = (((c*Cs*(dT^n))^2)+temp1)^0.5, !- Program Line 16
  Set Qinf = (@Max Qinf 0),               !- Program Line 17
  Set mech_vent_house_fan_sensible_load_equip_act = 0.0, !- Program Line 18
  Set mech_vent_house_fan_latent_load_equip_act = 0.0, !- Program Line 19
  Set OASupInPb = out_pb_s,               !- Program Line 20
  Set OASupInTemp = tout_s,               !- Program Line 21
  Set OASupInW = out_wt_s,                !- Program Line 22
  Set OASupRho = (@RhoAirFnPbTdbW OASupInPb OASupInTemp OASupInW), !- Program Line 23
  Set OASupCp = (@CpAirFnW OASupInW),     !- Program Line 24
  Set OASupInEnth = (@HFnTdbW OASupInTemp OASupInW), !- Program Line 25
  Set ZoneTemp = tin_s,                   !- Program Line 26
  Set ZoneW = win_s,                      !- Program Line 27
  Set ZoneCp = (@CpAirFnW ZoneW),         !- Program Line 28
  Set ZoneAirEnth = (@HFnTdbW ZoneTemp ZoneW), !- Program Line 29
  Set mech_vent_house_fan_cfis_act = 0.0, !- Program Line 30
  Set QWHV_cfis_sup = 0.0,                !- Program Line 31
  Set QWHV_cfis_suppl_sup = 0.0,          !- Program Line 32
  Set QWHV_cfis_suppl_exh = 0.0,          !- Program Line 33
  Set Qrange = 0,                         !- Program Line 34
  Set Qrange = Qrange + 0.04719 * mech_vent_range_fan_0_sch_s, !- Program Line 35
  Set Qbath = 0,                          !- Program Line 36
  Set Qbath = Qbath + 0.04719 * mech_vent_bath_fan_0_sch_s, !- Program Line 37
  Set Qdryer = 0,                         !- Program Line 38
  Set Qdryer = Qdryer + 0.09539 * clothes_dryer_exhaust_0_sch_s, !- Program Line 39
  Set QWHV_sup = 0.0,                     !- Program Line 40
  Set QWHV_exh = 0.0,                     !- Program Line 41
  Set Qexhaust = Qrange + Qbath + Qdryer + QWHV_exh + QWHV_cfis_suppl_exh, !- Program Line 42
  Set Qsupply = QWHV_sup + QWHV_cfis_sup + QWHV_cfis_suppl_sup, !- Program Line 43
  Set Qfan = (@Max Qexhaust Qsupply),     !- Program Line 44
  If Qfan > 0,                            !- Program Line 45
  Set Qavg = ((Qexhaust + Qsupply) / 2.0), !- Program Line 46
  If ((@Abs (Qexhaust - Qavg)) / Qavg) <= 0.1, !- Program Line 47
  Set phi = 1,                            !- Program Line 48
  Else,                                   !- Program Line 49
  Set phi = (Qinf / (Qinf + Qfan)),       !- Program Line 50
  EndIf,                                  !- Program Line 51
  Set Qinf_adj = phi * Qinf,              !- Program Line 52
  Else,                                   !- Program Line 53
  Set Qinf_adj = Qinf,                    !- Program Line 54
  EndIf,                                  !- Program Line 55
  Set infil_flow_act = Qinf_adj,          !- Program Line 56
  Set Qload = Qfan,                       !- Program Line 57
  Set Effectiveness_Sens = 0.0,           !- Program Line 58
  Set Effectiveness_Lat = 0.0,            !- Program Line 59
  Set Fan_MFR = Qload * OASupRho,         !- Program Line 60
  Set ZoneInEnth = OASupInEnth,           !- Program Line 61
  Set ZoneInTemp = OASupInTemp,           !- Program Line 62
  Set FanTotalToCond = Fan_MFR * (ZoneInEnth - ZoneAirEnth), !- Program Line 63
  Set FanSensToCond = Fan_MFR * ZoneCp * (ZoneInTemp - ZoneTemp), !- Program Line 64
  Set FanLatToCond = FanTotalToCond - FanSensToCond, !- Program Line 65
  Set mech_vent_house_fan_sensible_load_equip_act = mech_vent_house_fan_sensible_load_equip_act + FanSensToCond, !- Program Line 66
  Set mech_vent_house_fan_latent_load_equip_act = mech_vent_house_fan_latent_load_equip_act + FanLatToCond; !- Program Line 67

